<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <AssemblyName>MetinInput</AssemblyName>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>CA1416</NoWarn>
    <IntermediateOutputPath>../../build/input-bridge-obj/</IntermediateOutputPath>
    <BaseOutputPath>../../build/input-bridge-managed/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../hidmaestro-sdk/HIDMaestro.Core.csproj" />
  </ItemGroup>
</Project>
